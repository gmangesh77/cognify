# ---- Stage 1: Builder ----
FROM python:3.12-slim AS builder

WORKDIR /app

# Install uv for fast dependency resolution
RUN pip install --no-cache-dir uv

# Install production dependencies only (no dev tools)
COPY pyproject.toml uv.lock ./
RUN uv sync --no-dev --frozen

# Copy application source
COPY src/ src/
COPY alembic/ alembic/
COPY alembic.ini .

# ---- Stage 2: Runtime ----
FROM python:3.12-slim

WORKDIR /app

# Install runtime system deps + Node.js 20 + Chromium for server-side Mermaid
# (mmdc) rendering to PNG, used by the Ghost/publishing path. mermaid-cli drives
# Puppeteer against the system Chromium (PUPPETEER_EXECUTABLE_PATH) rather than a
# bundled download (PUPPETEER_SKIP_DOWNLOAD).
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        libpq5 curl ca-certificates gnupg chromium fonts-liberation && \
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    rm -rf /var/lib/apt/lists/*

ENV PUPPETEER_SKIP_DOWNLOAD=true \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Create non-root user BEFORE the COPYs so --chown can apply ownership at
# copy time (avoids a slow recursive `chown -R /app` over the .venv on
# every src change). Writable HOME for HF cache, matplotlib config, etc.
RUN groupadd -r cognify && useradd -r -g cognify -u 1000 -m -d /home/cognify cognify

# Copy virtualenv and source from builder, owned by cognify at copy time
COPY --from=builder --chown=cognify:cognify /app/.venv /app/.venv
COPY --from=builder --chown=cognify:cognify /app/src /app/src
COPY --from=builder --chown=cognify:cognify /app/alembic /app/alembic
COPY --from=builder --chown=cognify:cognify /app/alembic.ini /app/alembic.ini
COPY --from=builder --chown=cognify:cognify /app/pyproject.toml /app/pyproject.toml

# Ensure venv binaries are on PATH
ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONPATH="/app"

# Create generated_assets dirs (already owned by cognify thanks to USER below + WORKDIR perms).
RUN mkdir -p generated_assets/charts generated_assets/illustrations generated_assets/diagrams && \
    chown cognify:cognify generated_assets generated_assets/charts generated_assets/illustrations generated_assets/diagrams

# Install mermaid-cli (mmdc) into /app/node_modules so diagram_generator's
# _MMDC_PATH (/app/node_modules/.bin/mmdc) resolves at runtime. Lockfile-pinned;
# Puppeteer reuses the system Chromium installed above (no bundled download).
COPY package.json package-lock.json ./
RUN npm ci --include=dev && \
    chown -R cognify:cognify /app/node_modules /app/package.json /app/package-lock.json

# Copy entrypoint script
COPY --chown=cognify:cognify docker-entrypoint.sh .
RUN chmod +x docker-entrypoint.sh

EXPOSE 8000

USER cognify

ENTRYPOINT ["./docker-entrypoint.sh"]
