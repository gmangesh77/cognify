# ---- Stage 1: Builder ----
FROM python:3.12-slim AS builder

WORKDIR /app

# Install uv for fast dependency resolution
RUN pip install --no-cache-dir uv

# Install production dependencies only (no dev tools)
COPY pyproject.toml uv.lock ./
RUN uv sync --no-dev --frozen

# Copy application source
COPY src/ src/
COPY alembic/ alembic/
COPY alembic.ini .

# ---- Stage 2: Runtime ----
FROM python:3.12-slim

WORKDIR /app

# Install minimal runtime system dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends libpq5 curl && \
    rm -rf /var/lib/apt/lists/*

# Create non-root user BEFORE the COPYs so --chown can apply ownership at
# copy time (avoids a slow recursive `chown -R /app` over the .venv on
# every src change). Writable HOME for HF cache, matplotlib config, etc.
RUN groupadd -r cognify && useradd -r -g cognify -u 1000 -m -d /home/cognify cognify

# Copy virtualenv and source from builder, owned by cognify at copy time
COPY --from=builder --chown=cognify:cognify /app/.venv /app/.venv
COPY --from=builder --chown=cognify:cognify /app/src /app/src
COPY --from=builder --chown=cognify:cognify /app/alembic /app/alembic
COPY --from=builder --chown=cognify:cognify /app/alembic.ini /app/alembic.ini
COPY --from=builder --chown=cognify:cognify /app/pyproject.toml /app/pyproject.toml

# Ensure venv binaries are on PATH
ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONPATH="/app"

# Create generated_assets dirs (already owned by cognify thanks to USER below + WORKDIR perms).
RUN mkdir -p generated_assets/charts generated_assets/illustrations generated_assets/diagrams && \
    chown cognify:cognify generated_assets generated_assets/charts generated_assets/illustrations generated_assets/diagrams

# Copy entrypoint script
COPY --chown=cognify:cognify docker-entrypoint.sh .
RUN chmod +x docker-entrypoint.sh

EXPOSE 8000

USER cognify

ENTRYPOINT ["./docker-entrypoint.sh"]
